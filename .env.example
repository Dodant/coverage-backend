# Book Cover Archive - Environment Variables
# Copy this file to .env and adjust values as needed

# ===========================================
# Development Environment (SPRING_PROFILES_ACTIVE=dev)
# ===========================================

# PostgreSQL
POSTGRES_DB=bookcover_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URI=http://localhost:9200

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Application
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# Production Environment (SPRING_PROFILES_ACTIVE=prod)
# ===========================================

# Database
DATABASE_URL=jdbc:postgresql://your-db-host:5432/bookcover_prod
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# Redis
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Elasticsearch
# ELASTICSEARCH_URI=http://your-elasticsearch-host:9200

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092

# JWT (MUST be at least 256 bits for HS256)
# JWT_SECRET=your-production-secret-key-minimum-256-bits-long
# JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000

# S3 Storage
# S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-northeast-2

# Rate Limiting (optional overrides)
# RATE_LIMIT_UPLOAD=10
# RATE_LIMIT_UPLOAD_WINDOW=3600
# RATE_LIMIT_COMMENT=30
# RATE_LIMIT_COMMENT_WINDOW=60
# RATE_LIMIT_LIKE=100
# RATE_LIMIT_LIKE_WINDOW=60
# RATE_LIMIT_REPORT=5
# RATE_LIMIT_REPORT_WINDOW=3600
